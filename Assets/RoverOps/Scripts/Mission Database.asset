      maxRoverMass: 500
      starGoals:
      - type: 0
        value: 0
        text: Reach the goal.
      - type: 1
        value: 2
        text: Use maximum 2 code blocks
      - type: 2
        value: 30
        text: Finish under 30 seconds
    - scene: Mission 3
      title: Collect the Rock
      description: Use camera readings to find and collect the rock.
