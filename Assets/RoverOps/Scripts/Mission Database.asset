  m_Script: {fileID: 11500000, guid: 673b78688168ef94094d6c0ba086d0ab, type: 3}
  m_Name: Mission Database
  m_EditorClassIdentifier: 
  sectors:
  - name: Sector 1
    label: Tutorial
    missions:
    - scene: Mission 1
      title: Reach the Target
      description: Drive the rover to the marked location.
      maxRoverMass: 500
      starGoals:
      - type: 0
        value: 0
        block: 1
        text: Reach the goal
      - type: 1
        value: 1
        block: 1
        text: Use max 1 code blocks
      - type: 2
        value: 15
        block: 1
        text: Finish under 15 seconds
    - scene: Mission 2
      title: Turn and Move
      description: Turn towards the flag and reach it.
      maxRoverMass: 500
      starGoals:
      - type: 0
        value: 0
        block: 1
        text: Reach the goal
      - type: 1
        value: 2
        block: 1
        text: Use maximum 2 code blocks
      - type: 2
        value: 30
        block: 1
        text: Finish under 30 seconds
    - scene: Mission 3
      title: Analyze a Rock
      description: Use camera readings to find and analyze a rock.
      maxRoverMass: 500
      starGoals:
      - type: 0
        value: 0
        block: 1
        text: Analyze a rock
      - type: 7
        value: 0
        block: 7
        text: Use If code blocks
      - type: 2
        value: 15
        block: 1
        text: Finish under 15 seconds
    - scene: Mission 4
      title: Small or Large?
      description: Equip the HD Camera, identify the correct sample by size (4) and
        analyze it.
      maxRoverMass: 500
      starGoals:
      - type: 0
        value: 0
        block: 1
        text: Analyze the correct rock
      - type: 7
        value: 0
        block: 11
        text: Use While code block
      - type: 2
        value: 20
        block: 1
        text: Finish under 20 seconds
  - name: Sector 2
    label: Tutorial
    missions:
    - scene: Mission 5
      title: First Discovery
      description: Analyse any rock and transmit the scientific data.
      maxRoverMass: 500
      starGoals:
      - type: 5
        value: 1
        block: 1
        text: Transmit scientific data
      - type: 7
        value: 0
        block: 12
        text: Use Repeat Forever code block
      - type: 2
        value: 55
        block: 1
        text: Finish under 55 seconds
    - scene: Mission 6
      title: Capture the Moment
      description: Photograph the rock, return to the lander and send the data.
