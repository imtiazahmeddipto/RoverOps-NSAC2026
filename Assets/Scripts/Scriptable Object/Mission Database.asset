      - type: 7
        value: 0
        block: 12
        text: Use Repeat Forever code block
      - type: 7
        value: 0
        block: 8
        text: Use Else code block
  - name: Sector 4
    label: Real Life Events
    missions:
    - scene: Mission 13
      title: Martian Blueberries
      description: "(Opportunity 2004\u20132018) Find and collect three samples."
      maxRoverMass: 250
      starGoals:
      - type: 0
        value: 0
        block: 1
        text: Collect all 3 samples
      - type: 7
        value: 0
        block: 12
        text: Use Repeat Forever code block
      - type: 3
        value: 50
        block: 7
        text: Finish with minimum 50% battery
    - scene: Mission 14
      title: Escape from Eagle Crater
