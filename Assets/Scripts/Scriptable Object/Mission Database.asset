      maxRoverMass: 235
      starGoals:
      - type: 0
        value: 0
        block: 1
        text: Send the correct photograph
      - type: 7
        value: 0
        block: 11
        text: Use While code block
      - type: 7
        value: 0
        block: 12
        text: Use Repeat Forever code block
    - scene: Mission 11
      title: 'The Dust Storm '
      description: "(Spirit 2004\u20132010) During a dust storm, avoid obstacles,
