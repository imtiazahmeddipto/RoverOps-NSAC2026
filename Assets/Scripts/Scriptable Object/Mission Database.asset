%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 673b78688168ef94094d6c0ba086d0ab, type: 3}
  m_Name: Mission Database
  m_EditorClassIdentifier: 
  sectors:
  - name: Sector 1
    label: Tutorial
    missions:
    - scene: Mission 1
      title: Reach the Target
      description: Drive the rover to the marked location.
      maxRoverMass: 180
      starGoals:
      - type: 0
        value: 0
        block: 1
        text: Reach the goal
      - type: 1
        value: 1
        block: 1
        text: Use max 1 code blocks
      - type: 2
        value: 25
        block: 1
        text: Finish under 25 seconds
    - scene: Mission 2
      title: Turn and Move
      description: Turn towards the flag and reach it.
      maxRoverMass: 180
      starGoals:
      - type: 0
        value: 0
        block: 1
        text: Reach the goal
      - type: 1
        value: 2
        block: 1
        text: Use maximum 2 code blocks
      - type: 2
        value: 35
        block: 1
        text: Finish under 35 seconds
    - scene: Mission 3
      title: Analyze a Rock
      description: Use camera readings to find and analyze a rock.
      maxRoverMass: 215
      starGoals:
      - type: 0
        value: 0
        block: 1
        text: Analyze a rock
      - type: 7
        value: 0
        block: 7
        text: Use If code blocks
      - type: 2
        value: 20
        block: 1
        text: Finish under 20 seconds
    - scene: Mission 4
      title: Small or Large?
      description: Equip the HD Camera, identify the correct sample by size (4) and
        analyze it.
      maxRoverMass: 215
      starGoals:
      - type: 0
        value: 0
        block: 1
        text: Analyze the correct rock
      - type: 7
        value: 0
        block: 11
        text: Use While code block
      - type: 2
        value: 22
        block: 1
        text: Finish under 22 seconds
  - name: Sector 2
    label: Tutorial
    missions:
    - scene: Mission 5
      title: First Discovery
      description: Analyse any rock and transmit the scientific data.
      maxRoverMass: 215
      starGoals:
      - type: 5
        value: 1
        block: 1
        text: Transmit scientific data
      - type: 7
        value: 0
        block: 12
        text: Use Repeat Forever code block
      - type: 2
        value: 60
        block: 1
        text: Finish under 60 seconds
    - scene: Mission 6
      title: Capture the Moment
      description: Photograph the rock, return to the lander and send the data.
      maxRoverMass: 220
      starGoals:
      - type: 0
        value: 0
        block: 1
        text: Send the correct photograph
      - type: 7
        value: 0
        block: 11
        text: Use While code block
      - type: 7
        value: 0
        block: 12
        text: Use Repeat Forever code block
    - scene: Mission 7
      title: Power & Traction Test
      description: Equip suitable wheels and a solar panel. Navigate the terrain,
        and reach the Lander.
      maxRoverMass: 250
      starGoals:
      - type: 0
        value: 0
        block: 1
        text: Reach the Lander
      - type: 7
        value: 5
        block: 6
        text: Use Wait code blocks
      - type: 3
        value: 50
        block: 1
        text: Reach with minimum 50% battery
    - scene: Mission 8
      title: Sample Collector
      description: Choose a suitable drill, collect three samples and store them.
      maxRoverMass: 250
      starGoals:
      - type: 0
        value: 0
        block: 1
        text: Collect all samples
      - type: 7
        value: 0
        block: 11
        text: Use While code block
      - type: 3
        value: 40
        block: 1
        text: Finish with minimum 40% battery
  - name: Sector 3
    label: Real Life Events
    missions:
    - scene: Mission 9
      title: First Contact
      description: (Sojourner 1997) Find and analyse Barnacle Bill rock (Size = 3m).
